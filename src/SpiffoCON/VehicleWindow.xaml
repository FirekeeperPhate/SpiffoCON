<Window x:Class="SpiffoCON.VehicleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1180" Height="800" MinWidth="900" MinHeight="520"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="IsEnabled" Value="{Binding HasVehicle}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="16,12,16,10">
        <!-- which one -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" VerticalAlignment="Top" ToolTip="Read again now (it follows the bridge's refreshes by itself)"
                    FontFamily="{StaticResource IconFont}" Content="&#xE72C;" Padding="10,7" />
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Opacity="0.8" Margin="0,2,0,0"
                           Visibility="{Binding Subtitle, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </DockPanel>
        <Border DockPanel.Dock="Top" Background="#30F2C14E" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
        </Border>
        <!-- what the last action said, and when this was read -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding UpdatedText}" Opacity="0.6" Margin="12,0,0,0" />
            <TextBlock Text="{Binding Main.StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Main.StatusText}" Opacity="0.85" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- the vehicle from above, each part in the colour of its condition; then what it is -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasVehicle, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Overall condition" Style="{StaticResource CardTitle}" />
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ConditionText}" Margin="10,0,0,0" MinWidth="52" TextAlignment="Right"
                                           FontWeight="SemiBold" Foreground="{Binding ConditionColor}"
                                           ToolTip="The mean of every part, one that is gone as 0: the figure of the game's mechanics window" />
                                <ProgressBar Value="{Binding Condition, Mode=OneWay}" Maximum="100" Height="8" VerticalAlignment="Center"
                                             Foreground="{Binding ConditionColor}" />
                            </DockPanel>
                            <TextBlock Text="{Binding MissingText}" TextWrapping="Wrap" Foreground="#FF6B6B" Margin="0,0,0,6"
                                       Visibility="{Binding MissingText, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock Text="front" FontSize="11" Opacity="0.5" HorizontalAlignment="Center" />
                            <Viewbox Stretch="Uniform" MaxHeight="400">
                                <Canvas Width="240" Height="440">
                                    <Rectangle Canvas.Left="44" Canvas.Top="14" Width="152" Height="412" RadiusX="26" RadiusY="26"
                                               Fill="#18808080" Stroke="#60808080" StrokeThickness="1.5" />
                                    <ItemsControl ItemsSource="{Binding Shapes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Width="240" Height="440" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Rectangle x:Name="Shape" Width="{Binding Width}" Height="{Binding Height}" RadiusX="{Binding Radius}" RadiusY="{Binding Radius}"
                                                           Fill="{Binding Fill}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                                                           ToolTip="{Binding Tip}" Cursor="Hand" MouseLeftButtonDown="Shape_MouseLeftButtonDown" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Missing}" Value="True">
                                                        <Setter TargetName="Shape" Property="StrokeDashArray" Value="3,2" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Green is whole, red is worn out, a dashed outline is a part that is gone. A click chooses the part in the list." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Visibility="{Binding Facts.Count, Converter={StaticResource PositiveToVisible}}">
                        <ItemsControl ItemsSource="{Binding Facts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="104" Opacity="0.65" />
                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- every part, by the game's categories -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Parts" Style="{StaticResource CardTitle}" />
                    <ListView x:Name="PartsList" ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart}" SelectionMode="Single"
                              ItemContainerStyle="{StaticResource GridRow}" SelectionChanged="PartsList_SelectionChanged">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Opacity="0.65" Margin="4,10,0,3" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Part" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Id}" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Condition" Width="88">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ConditionText}" Foreground="{Binding Color}" FontWeight="SemiBold" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="92">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding RepairText}" FontSize="11" Padding="10,1" MinHeight="0" MinWidth="76"
                                                    IsEnabled="{Binding CanRepair}" ToolTip="{Binding RepairTip}" ToolTipService.ShowOnDisabled="True"
                                                    Command="{Binding DataContext.RepairPartCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="In it" Width="242">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" TextTrimming="CharacterEllipsis" Opacity="0.75" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- what can be done to the whole vehicle -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8,10,8,8" Margin="10,0,0,0" Width="186">
                <StackPanel>
                    <TextBlock Text="Actions" Style="{StaticResource CardTitle}" Margin="4,0,0,8" />
                    <Button Style="{StaticResource Action}" Content="Repair everything…" Command="{Binding RepairAllCommand}"
                            ToolTip="Every part back to 100%, tyres inflated, tank filled; the parts that are gone are put back" />
                    <Button Style="{StaticResource Action}" Content="Refuel…" Command="{Binding RefuelCommand}" ToolTip="Fills the tank" />
                    <Button Style="{StaticResource Action}" Content="Give a key to  &#x25B8;" Click="GiveKey_Click"
                            ToolTip="A key of this vehicle in the inventory of a player who is online" />
                    <Button Style="{StaticResource Action}" Content="Show on the map" Command="{Binding ShowOnMapCommand}" Margin="0,6,0,3" />
                    <Button Style="{StaticResource Action}" Content="Copy x,y,z" Command="{Binding CopyPositionCommand}" />
                    <Button Style="{StaticResource Action}" Content="Remove…" Command="{Binding RemoveCommand}" Margin="0,6,0,3"
                            ToolTip="Takes the vehicle out of the world for good" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
