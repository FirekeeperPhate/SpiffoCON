<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- only for the tray icon of desktop notifications (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SpiffoCON</RootNamespace>
    <AssemblyName>SpiffoCON</AssemblyName>
    <Version>0.12.1</Version>
    <ApplicationIcon>Assets\spiffocon.ico</ApplicationIcon>
    <Product>SpiffoCON</Product>
    <Authors>Phate</Authors>
    <Copyright>Copyright (C) 2026 Phate</Copyright>
    <!-- ThemeMode (the Fluent theme) is still marked experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF names win: no WinForms/Drawing global usings -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpiffoCON.Core\SpiffoCON.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\spiffocon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- the bridge mod ships next to the exe, for "Prepare Workshop upload" -->
    <None Include="..\..\bridge\**\*" LinkBase="bridge" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
