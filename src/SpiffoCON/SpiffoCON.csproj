<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SpiffoCON</RootNamespace>
    <AssemblyName>SpiffoCON</AssemblyName>
    <Version>0.1.0</Version>
    <Product>SpiffoCON</Product>
    <Authors>Phate</Authors>
    <Copyright>Copyright (C) 2026 Phate</Copyright>
    <!-- ThemeMode (the Fluent theme) is still marked experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpiffoCON.Core\SpiffoCON.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the bridge mod ships next to the exe, for "Prepare Workshop upload" -->
    <None Include="..\..\bridge\**\*" LinkBase="bridge" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
