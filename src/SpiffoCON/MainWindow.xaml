<Window x:Class="SpiffoCON.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SpiffoCON.ViewModels"
        xmlns:controls="clr-namespace:SpiffoCON.Controls"
        Title="{Binding SelectedServer.DisplayName, StringFormat='{}{0} - SpiffoCON', FallbackValue=SpiffoCON}" Width="1320" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="Assets/spiffocon.ico">
    <Window.Resources>
        <!-- shared by the Options and Sandbox tabs -->
        <controls:OptionEditorSelector x:Key="OptionEditor">
            <controls:OptionEditorSelector.Boolean>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding BoolValue}" Content="Enabled" />
                </DataTemplate>
            </controls:OptionEditorSelector.Boolean>
            <controls:OptionEditorSelector.Enum>
                <DataTemplate>
                    <ComboBox ItemsSource="{Binding Info.Values}" SelectedIndex="{Binding EnumIndex}" />
                </DataTemplate>
            </controls:OptionEditorSelector.Enum>
            <controls:OptionEditorSelector.Text>
                <DataTemplate>
                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             TextWrapping="Wrap" Height="96" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                </DataTemplate>
            </controls:OptionEditorSelector.Text>
            <controls:OptionEditorSelector.Line>
                <DataTemplate>
                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
            </controls:OptionEditorSelector.Line>
            <!-- Mods, WorkshopItems, Map: the list editor opens full width under the option -->
            <controls:OptionEditorSelector.List>
                <DataTemplate>
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsExpanded}" Margin="6,0,0,0" Padding="8,4"
                                      ToolTip="Edit as a list, one entry per line">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;" />
                        </ToggleButton>
                        <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </DataTemplate>
            </controls:OptionEditorSelector.List>
        </controls:OptionEditorSelector>

        <Style x:Key="OptionPages" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="ItemsSource" Value="{Binding Pages}" />
            <Setter Property="SelectedItem" Value="{Binding SelectedPage}" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type vm:OptionPage}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="#FFD28A1E" CornerRadius="8" Padding="6,0" Margin="6,0,0,0"
                                    Visibility="{Binding Changed, Converter={StaticResource PositiveToVisible}}">
                                <TextBlock Text="{Binding Changed}" FontSize="11" Foreground="Black" />
                            </Border>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Opacity="0.5" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="ItemsSource" Value="{Binding View}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <!-- Standard, not Recycling: a recycled enum ComboBox moved to another option wrote its
                 index into it (options changed without being touched, seen on Sandbox pages) -->
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type vm:OptionItem}">
                        <Border x:Name="Row" Margin="0,0,6,6" Padding="12,8" CornerRadius="6" Background="#12808080"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- list options (Mods, WorkshopItems, Map) opened as one entry per line -->
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontSize="12" Opacity="0.7" Margin="0,0,0,4">
                                        <Run Text="{Binding ListCount, Mode=OneWay}" />
                                        <Run Text="entries, one per line, in load order. Applied to the field above when you leave the box." />
                                    </TextBlock>
                                    <TextBox Text="{Binding ListText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="NoWrap"
                                             MinHeight="120" MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Key}" FontFamily="{StaticResource MonoFont}" FontSize="11" Opacity="0.5"
                                               Visibility="{Binding Key, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,2,0,0"
                                               Visibility="{Binding Description, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock Text="{Binding Warning}" Foreground="#F2C14E" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding Warning, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock Text="{Binding Hint}" Opacity="0.5" FontSize="11" Margin="0,4,0,0"
                                               Visibility="{Binding Hint, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource OptionEditor}" Focusable="False" />
                                    <TextBlock Text="{Binding Error}" Foreground="#FF7A7A" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Content="Undo" FontSize="11" Padding="8,2" MinHeight="0"
                                                Command="{Binding DataContext.RevertItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsChanged, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Default" FontSize="11" Padding="8,2" MinHeight="0" Margin="6,0,0,0"
                                                Command="{Binding DataContext.ResetToDefaultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="#FFD28A1E" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Connection panel: always there while not connected; hidden by itself once connected -->
        <ScrollViewer Grid.Column="0" Width="290" VerticalScrollBarVisibility="Auto" Padding="16,12,12,12"
                      Visibility="{Binding ShowConnectionPanel, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Server" Style="{StaticResource SectionTitle}" />
                <StackPanel IsEnabled="{Binding CanEditConnection}" KeyDown="ConnectionFields_KeyDown">
                    <ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                              DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                              ToolTip="Saved servers (disconnect to switch)" />
                    <UniformGrid Columns="3" Margin="0,6,0,0">
                        <Button Content="New" Command="{Binding AddServerCommand}" HorizontalAlignment="Stretch" Padding="4,5,4,6" Margin="0,0,3,0"
                                ToolTip="Add an empty server to the list" />
                        <Button Content="Duplicate" Command="{Binding DuplicateServerCommand}" HorizontalAlignment="Stretch" Padding="4,5,4,6" Margin="3,0"
                                ToolTip="Copy this server's settings into a new entry (e.g. another server on the same host)" />
                        <Button Content="Delete" Command="{Binding DeleteServerCommand}" HorizontalAlignment="Stretch" Padding="4,5,4,6" Margin="3,0,0,0"
                                ToolTip="Remove this server from the list" />
                    </UniformGrid>
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Host (IP or name)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="HostBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="RCON port" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding RconPort, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="RCON password" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="RconPasswordBox" PasswordChanged="RconPasswordBox_PasswordChanged" />
                    <CheckBox Content="Remember passwords (encrypted)" IsChecked="{Binding RememberPasswords}" Margin="0,8,0,0" />
                </StackPanel>

                <Grid Margin="0,12,0,0">
                    <!-- no IsDefault: Enter in any search box of the tabs would connect; the fields above handle it -->
                    <Button Content="Connect" Command="{Binding ConnectCommand}" HorizontalAlignment="Stretch"
                            Visibility="{Binding CanEditConnection, Converter={StaticResource BoolToVisibility}}"
                            x:Name="ConnectButton" />
                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}" HorizontalAlignment="Stretch"
                            Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Separator Margin="0,18,0,8" />

                <TextBlock Text="File access (SFTP, optional)" Style="{StaticResource SectionTitle}" />
                <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" FontSize="12"
                           Text="Used to read server config, logs and mod files. Without it, mods come from your Steam folder or SteamCMD." />
                <CheckBox Content="Use SFTP" IsChecked="{Binding SftpEnabled}" Margin="0,8,0,0" />
                <StackPanel IsEnabled="{Binding SftpEnabled}"
                            Visibility="{Binding SftpEnabled, Converter={StaticResource BoolToVisibility}}">
                    <CheckBox Content="Different SFTP host" IsChecked="{Binding SftpCustomHost}" Margin="0,8,0,0"
                              ToolTip="Some hosts serve SFTP from another address than the game server" />
                    <StackPanel Visibility="{Binding SftpCustomHost, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="SFTP host" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SftpHost, UpdateSourceTrigger=PropertyChanged}" ToolTip="Leave the box unticked to use the server's host" />
                    </StackPanel>
                    <TextBlock Text="SFTP port" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SftpPort, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="SFTP user" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SftpUser, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="Same password as RCON" IsChecked="{Binding SftpSamePassword}" Margin="0,8,0,0" x:Name="SamePasswordCheck" />
                    <StackPanel Visibility="{Binding IsChecked, ElementName=SamePasswordCheck, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="SFTP password" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="SftpPasswordBox" PasswordChanged="SftpPasswordBox_PasswordChanged" />
                    </StackPanel>
                    <CheckBox Content="On connect: bridge, logs and mods" IsChecked="{Binding AutoConnectFiles}" Margin="0,8,0,0"
                              ToolTip="When RCON connects: Find on server in the Bridge tab, then in the Logs tab, then Load from server in the Catalog tab (over SFTP only, never SteamCMD)" />
                    <Button Content="Test SFTP" Command="{Binding TestSftpCommand}" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                            Click="TestSftp_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- hide / show the connection panel (only while connected) -->
        <Button Grid.Column="1" Content="{Binding ConnectionPanelGlyph}" FontFamily="{StaticResource IconFont}" Command="{Binding ToggleConnectionPanelCommand}"
                ToolTip="{Binding ConnectionPanelTip}" VerticalAlignment="Top" Margin="4,12,8,0" Padding="6,8" MinWidth="0"
                Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVisibility}}" />

        <!-- Work area -->
        <TabControl Grid.Column="2" Margin="0,8,0,8" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged" SizeChanged="Tabs_SizeChanged">
            <TabControl.Resources>
                <!-- the space between the headers follows the room there is (SpaceTabs in the code-behind): wide
                     when the tabs have the window, down to this when the connection panel is open, so the 14
                     tabs stay on one row (the Fluent tab border already has 6 px each side) -->
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="Padding" Value="-3,0" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Console">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="ConsoleList" ItemsSource="{Binding ConsoleLines}" SelectionMode="Extended"
                             FontFamily="{StaticResource MonoFont}" FontSize="13"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             KeyDown="ConsoleList_KeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy" Click="CopyConsole_Click" />
                                <MenuItem Header="Clear" Command="{Binding ClearConsoleCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="6,1" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConsoleLine}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TimeText}" Opacity="0.45" Margin="0,0,10,0" />
                                    <TextBlock x:Name="LineText" Text="{Binding Text}" TextWrapping="NoWrap" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Command">
                                        <Setter TargetName="LineText" Property="Foreground" Value="#7FB8FF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Info">
                                        <Setter TargetName="LineText" Property="Foreground" Value="#8FD694" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                        <Setter TargetName="LineText" Property="Foreground" Value="#F2C14E" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                        <Setter TargetName="LineText" Property="Foreground" Value="#FF7A7A" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="1" Margin="0,8,0,0" IsEnabled="{Binding IsSessionActive}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ConsoleInputBox" Text="{Binding ConsoleInput, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource MonoFont}" PreviewKeyDown="ConsoleInput_PreviewKeyDown"
                                 ToolTip="Enter sends, Up/Down browse history. Example: players, save, servermsg &quot;hi&quot;" />
                        <Button Grid.Column="1" Content="Send" Command="{Binding SendConsoleCommand}" Margin="8,0,0,0" MinWidth="80" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Players" DataContext="{Binding Players}">
                <Grid Margin="0,8,0,0" IsEnabled="{Binding DataContext.IsSessionActive, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- online list -->
                    <DockPanel Margin="0,0,10,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="&#xE72C;" FontFamily="{StaticResource IconFont}"
                                    Command="{Binding RefreshCommand}" ToolTip="Refresh now" />
                            <TextBlock Text="{Binding OnlineCount}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <CheckBox DockPanel.Dock="Bottom" Content="Refresh every 30 s" IsChecked="{Binding AutoRefresh}" Margin="0,6,0,0" />
                        <ListBox ItemsSource="{Binding OnlinePlayers}" SelectedItem="{Binding SelectedOnline}" controls:PlayerMenu.Enabled="True" />
                    </DockPanel>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Player" Style="{StaticResource SectionTitle}" />
                                    <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" FontSize="15"
                                             ToolTip="Pick from the list, or type any username (also offline, e.g. to ban or unban)" />
                                    <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Grid IsEnabled="{Binding HasTarget}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Moderation" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Reason (optional, shown to the player)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Content="Kick" Command="{Binding KickCommand}" Style="{StaticResource PairButton}" />
                                                <Button Content="Ban" Command="{Binding BanCommand}" Style="{StaticResource PairButton}" />
                                                <Button Content="Unban" Command="{Binding UnbanCommand}" Style="{StaticResource PairButton}" />
                                            </WrapPanel>
                                            <CheckBox Content="Ban the IP address too" IsChecked="{Binding BanIp}" Margin="0,8,0,0" />
                                            <TextBlock Text="Voice chat" Style="{StaticResource FieldLabel}" />
                                            <WrapPanel>
                                                <Button Content="Mute" Command="{Binding VoiceBanCommand}" CommandParameter="true" Style="{StaticResource PairButton}" />
                                                <Button Content="Unmute" Command="{Binding VoiceBanCommand}" CommandParameter="false" Style="{StaticResource PairButton}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Access level" Style="{StaticResource SectionTitle}" />
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding AccessLevels}" SelectedItem="{Binding AccessLevel}" />
                                                <Button Grid.Column="1" Content="Set" Command="{Binding SetAccessLevelCommand}" Margin="8,0,0,0" MinWidth="64" />
                                            </Grid>
                                            <TextBlock Text="user = regular player, priority = can join a full server" Opacity="0.6" FontSize="12" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Teleport" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="To another player" Style="{StaticResource FieldLabel}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding OnlinePlayers}" SelectedItem="{Binding TeleportTarget}" />
                                                <Button Grid.Column="1" Content="Go" Command="{Binding TeleportToPlayerCommand}" Margin="8,0,0,0" MinWidth="64" />
                                            </Grid>
                                            <TextBlock Text="To coordinates (x, y, floor)" Style="{StaticResource FieldLabel}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding CoordX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberField}" ToolTip="x" />
                                                <TextBox Grid.Column="1" Text="{Binding CoordY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberField}" Margin="6,0,0,0" ToolTip="y" />
                                                <TextBox Grid.Column="2" Text="{Binding CoordZ, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberField}" MinWidth="0" Margin="6,0,0,0" ToolTip="floor (0 = ground)" />
                                                <Button Grid.Column="3" Content="Go" Command="{Binding TeleportToCoordinatesCommand}" Margin="8,0,0,0" MinWidth="64" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Powers" Style="{StaticResource SectionTitle}" Grid.ColumnSpan="2" Margin="0,4,0,4" />
                                            <TextBlock Grid.Row="1" Text="God mode" VerticalAlignment="Center" />
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                                <Button Content="On" Command="{Binding GodModeCommand}" CommandParameter="true" Style="{StaticResource PairButton}" />
                                                <Button Content="Off" Command="{Binding GodModeCommand}" CommandParameter="false" Style="{StaticResource PairButton}" Margin="0" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="Invisible to zombies" VerticalAlignment="Center" />
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                                <Button Content="On" Command="{Binding InvisibleCommand}" CommandParameter="true" Style="{StaticResource PairButton}" />
                                                <Button Content="Off" Command="{Binding InvisibleCommand}" CommandParameter="false" Style="{StaticResource PairButton}" Margin="0" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="3" Text="No clip (walk through walls)" VerticalAlignment="Center" />
                                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                                <Button Content="On" Command="{Binding NoClipCommand}" CommandParameter="true" Style="{StaticResource PairButton}" />
                                                <Button Content="Off" Command="{Binding NoClipCommand}" CommandParameter="false" Style="{StaticResource PairButton}" Margin="0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Skills" Style="{StaticResource SectionTitle}" />
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding Perks}" SelectedItem="{Binding SelectedPerk}" DisplayMemberPath="Name" />
                                                <TextBox Grid.Column="1" Text="{Binding XpAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberField}" Margin="6,0,0,0" ToolTip="XP to add" />
                                                <Button Grid.Column="2" Content="Add XP" Command="{Binding AddXpCommand}" Margin="8,0,0,0" />
                                            </Grid>
                                            <CheckBox Content="Apply the server's XP multiplier" IsChecked="{Binding UseMultiplier}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Events" DataContext="{Binding Events}">
                <Grid Margin="0,8,0,0" IsEnabled="{Binding DataContext.IsSessionActive, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- weather -->
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Rain" Style="{StaticResource SectionTitle}" />
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding RainIntensity}" Width="34" TextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="Intensity" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Slider Minimum="1" Maximum="100" Value="{Binding RainIntensity}" IsSnapToTickEnabled="True" TickFrequency="1"
                                            VerticalAlignment="Center" ToolTip="1 = drizzle, 100 = downpour" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox Content="Stop it after" IsChecked="{Binding RainStopsAfter}" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding RainMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberField}" Margin="8,0" IsEnabled="{Binding RainStopsAfter}" />
                                    <TextBlock Text="minutes" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="The server has no rain duration: SpiffoCON sends stoprain when the time is up, so it must stay open and connected."
                                           Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Start rain" Command="{Binding StartRainCommand}" Style="{StaticResource PairButton}" />
                                    <Button Content="Stop rain" Command="{Binding StopRainCommand}" Style="{StaticResource PairButton}" />
                                </WrapPanel>
                                <DockPanel Margin="0,8,0,0" Visibility="{Binding RainTimerVisible, Converter={StaticResource BoolToVisibility}}">
                                    <Button DockPanel.Dock="Right" Content="Cancel timer" Command="{Binding CancelRainTimerCommand}" FontSize="12" Padding="8,2" MinHeight="0" />
                                    <TextBlock Text="{Binding RainTimerText}" Foreground="#F2C14E" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Thunderstorm" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Lasts" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding StormHours, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberField}" Margin="8,0" />
                                    <TextBlock Text="game hours" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Game time: how long that is in real time depends on the server's day length."
                                           Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Start storm" Command="{Binding StartStormCommand}" Style="{StaticResource PairButton}" />
                                    <Button Content="Stop all weather" Command="{Binding StopWeatherCommand}" Style="{StaticResource PairButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- events on players -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Events on players" Style="{StaticResource SectionTitle}" />
                            <ComboBox ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" DisplayMemberPath="Name" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding SelectedEvent.Description}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />

                            <StackPanel Visibility="{Binding PlayerTargeted, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="On" Style="{StaticResource FieldLabel}" />
                                <RadioButton Content="A random online player" IsChecked="{Binding TargetRandom}" GroupName="EventTarget" />
                                <RadioButton Content="Every online player" IsChecked="{Binding TargetEveryone}" GroupName="EventTarget" Margin="0,4,0,0" />
                                <DockPanel Margin="0,4,0,0">
                                    <RadioButton Content="This player" IsChecked="{Binding TargetChosen}" GroupName="EventTarget" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding OnlinePlayers}" SelectedItem="{Binding ChosenPlayer}" Margin="10,0,0,0" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                            Visibility="{Binding IsHorde, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Zombies" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding HordeSize, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberField}" Margin="8,0" />
                                    <TextBlock Text="per player (max 500)" Opacity="0.6" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Trigger" Command="{Binding TriggerCommand}" MinWidth="120" Style="{StaticResource PairButton}" />
                                <Button Content="Stop helicopter" Command="{Binding StopChopperCommand}" Style="{StaticResource PairButton}"
                                        Visibility="{Binding IsChopper, Converter={StaticResource BoolToVisibility}}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <!-- weather overrides: bridge v5 -->
                    <Border Grid.Column="4" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Weather and time" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,8,0,0" IsEnabled="{Binding Bridge.CanSetWeather}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="62" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox Grid.Row="0" Content="Fog" IsChecked="{Binding FogOn}" MinWidth="0" Margin="0,2,10,2" VerticalAlignment="Center" ToolTip="How thick the fog is" />
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Fog}" IsSnapToTickEnabled="True" TickFrequency="1"
                                        IsEnabled="{Binding FogOn}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Fog, StringFormat={}{0:0} %}" TextAlignment="Right" VerticalAlignment="Center"
                                           Opacity="{Binding FogOn, Converter={StaticResource OnOpacity}}" />
                                <CheckBox Grid.Row="1" Content="Clouds" IsChecked="{Binding CloudsOn}" MinWidth="0" Margin="0,2,10,2" VerticalAlignment="Center" ToolTip="How cloudy the sky is" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Clouds}" IsSnapToTickEnabled="True" TickFrequency="1"
                                        IsEnabled="{Binding CloudsOn}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Clouds, StringFormat={}{0:0} %}" TextAlignment="Right" VerticalAlignment="Center"
                                           Opacity="{Binding CloudsOn, Converter={StaticResource OnOpacity}}" />
                                <CheckBox Grid.Row="2" Content="Wind" IsChecked="{Binding WindOn}" MinWidth="0" Margin="0,2,10,2" VerticalAlignment="Center" ToolTip="Wind speed" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="120" Value="{Binding Wind}" IsSnapToTickEnabled="True" TickFrequency="1"
                                        IsEnabled="{Binding WindOn}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Wind, StringFormat={}{0:0} km/h}" TextAlignment="Right" VerticalAlignment="Center"
                                           Opacity="{Binding WindOn, Converter={StaticResource OnOpacity}}" />
                                <CheckBox Grid.Row="3" Content="Temperature" IsChecked="{Binding TemperatureOn}" MinWidth="0" Margin="0,2,10,2" VerticalAlignment="Center" ToolTip="Air temperature" />
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="-30" Maximum="45" Value="{Binding Temperature}" IsSnapToTickEnabled="True" TickFrequency="1"
                                        IsEnabled="{Binding TemperatureOn}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Temperature, StringFormat={}{0:0} °C}" TextAlignment="Right" VerticalAlignment="Center"
                                           Opacity="{Binding TemperatureOn, Converter={StaticResource OnOpacity}}" />
                                <CheckBox Grid.Row="4" Content="Snowfall" IsChecked="{Binding SnowOn}" MinWidth="0" Margin="0,2,10,2" VerticalAlignment="Center" ToolTip="Snow falling (instead of rain), and how much" />
                                <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Snow}" IsSnapToTickEnabled="True" TickFrequency="1"
                                        IsEnabled="{Binding SnowOn}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Snow, StringFormat={}{0:0} %}" TextAlignment="Right" VerticalAlignment="Center"
                                           Opacity="{Binding SnowOn, Converter={StaticResource OnOpacity}}" />
                            </Grid>
                            <TextBlock Text="Ticked: set by SpiffoCON until given back. Unticked: the game decides."
                                       Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <WrapPanel Margin="0,10,0,0" IsEnabled="{Binding Bridge.CanSetWeather}">
                                <Button Content="Apply" Command="{Binding ApplyWeatherCommand}" Style="{StaticResource PairButton}"
                                        ToolTip="Players see it at the next climate update, within ten game minutes" />
                                <Button Content="Back to the game's weather" Command="{Binding ResetWeatherCommand}" Style="{StaticResource PairButton}"
                                        ToolTip="Every setting back to the game (the settings are saved with the world until then)" />
                            </WrapPanel>
                            <!-- time of day: bridge v7 -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" IsEnabled="{Binding Bridge.CanSetTime}">
                                <TextBlock Text="Time of day" VerticalAlignment="Center" />
                                <TextBox Text="{Binding TimeOfDay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberField}" Margin="8,0"
                                         ToolTip="Hours and minutes, like 8:30 or 21:00" />
                                <Button Content="Set" Command="{Binding SetTimeCommand}"
                                        ToolTip="Skips the clock forward to the next time it is that hour, for everyone (bridge v7): the game has no way back. Players see it within ten seconds" />
                            </StackPanel>
                            <TextBlock Text="{Binding WeatherResult}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding WeatherResult, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock Text="{Binding WeatherStatus}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>



                    <!-- log -->
                    <DockPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,4,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearLogCommand}" FontSize="12" Padding="8,2" MinHeight="0" />
                            <TextBlock Text="Sent events" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Log}" FontSize="13">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="10,3" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EventLogLine}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TimeText}" Opacity="0.5" FontFamily="{StaticResource MonoFont}" Margin="0,0,10,0" />
                                        <TextBlock x:Name="Line" Text="{Binding Text}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Failed}" Value="True">
                                            <Setter TargetName="Line" Property="Foreground" Value="#FF7A7A" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Accounts" DataContext="{Binding Accounts}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="Find on server" Command="{Binding FindOnServerCommand}"
                                ToolTip="Read Zomboid/db and players.db over SFTP" />
                        <Button DockPanel.Dock="Left" Content="Open folder…" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0"
                                ToolTip="A local Zomboid folder (a server on this PC)" />
                        <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" Margin="8,0,0,0" MinWidth="130"
                                  ToolTip="Server (db/&lt;name&gt;.db)" IsEnabled="{Binding IsLoaded}" />
                        <Button DockPanel.Dock="Left" Content="&#xE72C;" FontFamily="{StaticResource IconFont}" Command="{Binding ReadCommand}"
                                Margin="8,0,0,0" IsEnabled="{Binding IsLoaded}" ToolTip="Read the databases again" />
                        <TextBlock Text="{Binding Source}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,8" IsEnabled="{Binding IsLoaded}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search username, character, Steam ID or role" />
                        <CheckBox Grid.Column="1" Content="Only banned" IsChecked="{Binding OnlyBanned}" Margin="12,0,0,0" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="330" />
                        </Grid.ColumnDefinitions>
                        <ListView ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource GridRow}"
                                  IsSynchronizedWithCurrentItem="False" controls:PlayerMenu.Enabled="True">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Account" Width="140" DisplayMemberBinding="{Binding Username}" />
                                    <GridViewColumn Header="Character" Width="140" DisplayMemberBinding="{Binding CharacterName}" />
                                    <GridViewColumn Header="Role" Width="85" DisplayMemberBinding="{Binding Role}" />
                                    <GridViewColumn Header="Status" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="S" Text="{Binding Status}" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="online">
                                                        <Setter TargetName="S" Property="Foreground" Value="#8FD694" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="banned">
                                                        <Setter TargetName="S" Property="Foreground" Value="#FF7A7A" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Last login" Width="110" DisplayMemberBinding="{Binding LastSeen}" />
                                    <GridViewColumn Header="Last position" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Position}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Kicks" Width="50" DisplayMemberBinding="{Binding Kicks}" />
                                    <GridViewColumn Header="Bans" Width="50" DisplayMemberBinding="{Binding Bans}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Border Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Select an account." Opacity="0.6"
                                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
                                <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Selected.Username}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0">
                                        <Run Text="Steam ID:" /> <Run Text="{Binding Selected.Account.SteamId, Mode=OneWay, TargetNullValue='—'}" />
                                    </TextBlock>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="To Players tab" Command="{Binding UseInPlayersTabCommand}" Margin="0,0,6,6"
                                                ToolTip="Put this account (and its last saved position) in the Players tab" />
                                        <Button Content="Ban" Command="{Binding BanCommand}" Margin="0,0,6,6" />
                                        <Button Content="Unban" Command="{Binding UnbanCommand}" Margin="0,0,6,6" />
                                    </WrapPanel>
                                    <TextBlock Text="History" Style="{StaticResource FieldLabel}" />
                                </StackPanel>
                                <ListView ItemsSource="{Binding History}" ItemContainerStyle="{StaticResource GridRow}"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="What" Width="65" DisplayMemberBinding="{Binding Type}" />
                                            <GridViewColumn Header="Reason" Width="110" DisplayMemberBinding="{Binding Text}" />
                                            <GridViewColumn Header="By" Width="55" DisplayMemberBinding="{Binding IssuedBy}" />
                                            <GridViewColumn Header="When" Width="80" DisplayMemberBinding="{Binding When, StringFormat='dd/MM HH:mm'}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Expander Grid.Row="3" Header="Banned IP addresses and Steam IDs" Margin="0,8,0,0" IsEnabled="{Binding IsLoaded}">
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ListView ItemsSource="{Binding BannedIps}" MaxHeight="140" ItemContainerStyle="{StaticResource GridRow}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="IP" Width="120" DisplayMemberBinding="{Binding Ip}" />
                                        <GridViewColumn Header="Account" Width="110" DisplayMemberBinding="{Binding Username}" />
                                        <GridViewColumn Header="Reason" Width="160" DisplayMemberBinding="{Binding Reason}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <ListView Grid.Column="1" ItemsSource="{Binding BannedSteamIds}" MaxHeight="140" Margin="10,0,0,0" ItemContainerStyle="{StaticResource GridRow}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Steam ID" Width="160" DisplayMemberBinding="{Binding SteamId}" />
                                        <GridViewColumn Header="Reason" Width="200" DisplayMemberBinding="{Binding Reason}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Expander>

                    <TextBlock Grid.Row="4" Text="{Binding StatusText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="Catalog" DataContext="{Binding Catalog}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- load + status -->
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="Load from server" Command="{Binding LoadFromServerCommand}"
                                IsEnabled="{Binding DataContext.IsSessionActive, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Reads the mod list with showoptions, then the mods' scripts (SFTP, your Steam folder, or SteamCMD)" />
                        <Button DockPanel.Dock="Left" Content="Game icons…" Command="{Binding ExtractIconsCommand}" Margin="8,0,0,0"
                                ToolTip="Take the base-game item icons from your Project Zomboid install (the server has none)" />
                        <ProgressBar DockPanel.Dock="Left" Width="80" Height="4" Margin="12,0,0,0" IsIndeterminate="True"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        <Button DockPanel.Dock="Left" Content="Cancel" Command="{Binding CancelLoadCommand}" Margin="8,0,0,0"
                                Padding="8,2" MinHeight="0" FontSize="12"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" Opacity="0.85" />
                    </DockPanel>

                    <!-- filters -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CatalogSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search name, ID or category (several words: all must match)" />
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding KindFilter}" Margin="8,0,0,0" MinWidth="110">
                            <ComboBoxItem Content="Everything" />
                            <ComboBoxItem Content="Items" />
                            <ComboBoxItem Content="Vehicles" />
                        </ComboBox>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SourceFilter}"
                                  Margin="8,0,0,0" MinWidth="170" MaxWidth="260" />
                        <CheckBox Grid.Column="3" Content="Hidden" IsChecked="{Binding ShowHidden}" Margin="12,0,0,0"
                                  ToolTip="Show items the game hides (internal visuals, obsolete items)" />
                        <TextBlock Grid.Column="4" Text="{Binding CountText}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.6" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="270" />
                        </Grid.ColumnDefinitions>

                        <ListView ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" SelectionMode="Single"
                                  IsSynchronizedWithCurrentItem="False" ItemContainerStyle="{StaticResource GridRow}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Width="24" Height="24">
                                                    <Image Source="{Binding IconPath, Converter={StaticResource Icon}}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" FontSize="16" Opacity="0.45"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE7B8;" Visibility="Collapsed" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                        <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Vehicle">
                                                        <Setter TargetName="Glyph" Property="Text" Value="&#xE804;" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Name" Width="240" DisplayMemberBinding="{Binding DisplayName}" />
                                    <GridViewColumn Header="ID" Width="220">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FullType}" FontFamily="{StaticResource MonoFont}" FontSize="12" Opacity="0.8" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Category" Width="130" DisplayMemberBinding="{Binding Category}" />
                                    <GridViewColumn Header="Source" Width="170" DisplayMemberBinding="{Binding Source.Label}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- selection + actions -->
                        <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="6" Background="#18808080">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Select an item or vehicle." Opacity="0.6" TextWrapping="Wrap"
                                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
                                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                    <Image Source="{Binding Selected.IconPath, Converter={StaticResource Icon}}" Width="48" Height="48"
                                           Visibility="{Binding Selected.IconPath, Converter={StaticResource NullToCollapsed}}"
                                           HorizontalAlignment="Left" Margin="0,0,0,8" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Selected.DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding Selected.FullType, Mode=OneWay}" IsReadOnly="True" Margin="0,6,0,0"
                                             FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                    <TextBlock Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap">
                                        <Run Text="{Binding Selected.Category, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding Selected.Source.Label, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Opacity="0.6" TextWrapping="Wrap" FontSize="12"
                                               Visibility="{Binding Selected.ChangedBy, Converter={StaticResource NullToCollapsed}}">
                                        <Run Text="Changed by" />
                                        <Run Text="{Binding Selected.ChangedBy.Label, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button Content="Copy ID" Command="{Binding CopyIdCommand}" Margin="0,8,0,0" HorizontalAlignment="Left" />

                                    <Separator Margin="0,14,0,6" />
                                    <TextBlock Text="Player" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox IsEditable="True" ItemsSource="{Binding Players}" Text="{Binding Player, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Content="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="6,0,0,0"
                                                Command="{Binding RefreshPlayersCommand}" ToolTip="Refresh online players" />
                                    </Grid>
                                    <StackPanel Visibility="{Binding IsItemSelected, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Content="Give item" Command="{Binding GiveItemCommand}" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                                IsEnabled="{Binding DataContext.IsSessionActive, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <TextBlock Text="Kit" Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding Kits}" SelectedItem="{Binding KitTarget}" DisplayMemberPath="Name"
                                                      ToolTip="The kit to add to (before any kit exists, a new one is made)" />
                                            <Button Grid.Column="1" Content="Add to kit" Command="{Binding AddToKitCommand}" Margin="6,0,0,0"
                                                    ToolTip="Add this item, in the quantity above, to the kit" />
                                        </Grid>
                                    </StackPanel>
                                    <Button Content="Spawn vehicle next to player" Command="{Binding SpawnVehicleCommand}" Margin="0,12,0,0"
                                            HorizontalAlignment="Stretch"
                                            Visibility="{Binding IsVehicleSelected, Converter={StaticResource BoolToVisibility}}"
                                            IsEnabled="{Binding DataContext.IsSessionActive, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBlock Text="{Binding ActionResult}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Expander Grid.Row="3" Header="Mod sources" Margin="0,8,0,0">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="{Binding ModSummary}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ListView ItemsSource="{Binding ModSources}" MaxHeight="160" ItemContainerStyle="{StaticResource GridRow}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Workshop item" Width="320" DisplayMemberBinding="{Binding Title}" />
                                        <GridViewColumn Header="ID" Width="110" DisplayMemberBinding="{Binding WorkshopId}" />
                                        <GridViewColumn Header="Files from" Width="110" DisplayMemberBinding="{Binding Source}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem Header="Kits" DataContext="{Binding Kits}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <!-- kits -->
                    <DockPanel Margin="0,0,10,0">
                        <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0">
                            <Button Content="New kit" Command="{Binding NewKitCommand}" HorizontalAlignment="Stretch" Margin="0,0,3,0" />
                            <Button Content="Delete" Command="{Binding DeleteKitCommand}" HorizontalAlignment="Stretch" Margin="3,0,0,0"
                                    IsEnabled="{Binding HasKit}" />
                        </UniformGrid>
                        <TextBlock DockPanel.Dock="Top" Text="Kits" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding Kits}" SelectedItem="{Binding SelectedKit}" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:KitView}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Opacity="0.5" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- contents -->
                    <DockPanel Grid.Column="1" IsEnabled="{Binding HasKit}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0" />
                            <TextBox Text="{Binding SelectedKit.Name, UpdateSourceTrigger=PropertyChanged}" FontSize="15" />
                            <TextBlock Text="Add items from the Catalog tab: select an item, set the quantity, then Add to kit. Kits are shared by all your servers."
                                       Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,8" />
                        </StackPanel>
                        <ListView ItemsSource="{Binding SelectedKit.Items}" ItemContainerStyle="{StaticResource GridRow}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Width="24" Height="24">
                                                    <Image Source="{Binding IconPath, Converter={StaticResource Icon}}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Item" Width="170">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="not in this server's catalog" FontSize="11" Foreground="#F2C14E"
                                                               Visibility="{Binding Known, Converter={StaticResource InverseBoolToVisibility}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="ID" Width="160">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FullType}" FontFamily="{StaticResource MonoFont}" FontSize="12" Opacity="0.8" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Qty" Width="92">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberField}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="46">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="&#xE711;" FontFamily="{StaticResource IconFont}" ToolTip="Remove from the kit"
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}" Padding="6,2" MinHeight="0" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>

                    <!-- give -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="10,0,0,0" VerticalAlignment="Top"
                            IsEnabled="{Binding DataContext.IsSessionActive, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel IsEnabled="{Binding HasKit}">
                            <TextBlock Text="Give the kit" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Player" Style="{StaticResource FieldLabel}" />
                            <ComboBox IsEditable="True" ItemsSource="{Binding OnlinePlayers}" Text="{Binding Player, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding ToPlayer}" />
                            <CheckBox Content="To every online player instead" IsChecked="{Binding Everyone}" Margin="0,8,0,0" />
                            <Button Content="Give" Command="{Binding GiveCommand}" HorizontalAlignment="Stretch" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Options" DataContext="{Binding Options}">
                <Grid Margin="0,8,0,0" IsEnabled="{Binding DataContext.IsSessionActive, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- toolbar -->
                    <Grid Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="&#xE72C;" FontFamily="{StaticResource IconFont}" Command="{Binding RefreshCommand}"
                                ToolTip="Read the options from the server again (showoptions)" />
                        <TextBox Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"
                                 ToolTip="Search option names and descriptions (all pages)" />
                        <CheckBox Grid.Column="2" Content="Only changed from default" IsChecked="{Binding OnlyNonDefault}" Margin="12,0,0,0" />
                        <Button Grid.Column="3" Content="Reload .ini" Command="{Binding ReloadFromFileCommand}" Margin="12,0,0,0"
                                ToolTip="reloadoptions: re-read the server's .ini after editing it by hand" />
                    </Grid>

                    <ListBox Grid.Row="1" Style="{StaticResource OptionPages}" />
                    <ListBox Grid.Row="1" Grid.Column="1" Style="{StaticResource OptionList}" />

                    <!-- apply bar -->
                    <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Apply changes" Command="{Binding ApplyCommand}" MinWidth="130"
                                IsEnabled="{Binding HasChanges}" />
                        <Button DockPanel.Dock="Right" Content="Discard" Command="{Binding DiscardCommand}" Margin="0,0,8,0"
                                IsEnabled="{Binding HasChanges}" />
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Sandbox" DataContext="{Binding Sandbox}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- file source -->
                    <Grid Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Find on server" Command="{Binding FindOnServerCommand}"
                                ToolTip="Look for Server/*.ini over SFTP; the sandbox file sits next to it" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ServerFiles}" SelectedItem="{Binding SelectedServerFile}" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Content="Load" Command="{Binding LoadFromServerCommand}" Margin="8,0,0,0" MinWidth="64" />
                        <Button Grid.Column="3" Content="Open file…" Command="{Binding OpenLocalFileCommand}" Margin="12,0,0,0"
                                ToolTip="Edit a local SandboxVars.lua (a local server, or a copy from your host's file manager)" />
                        <Button Grid.Column="4" Content="&#xE72C;" FontFamily="{StaticResource IconFont}" Command="{Binding ReloadCommand}"
                                Margin="8,0,0,0" ToolTip="Read the file again" />
                    </Grid>

                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8" IsEnabled="{Binding IsLoaded}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search names, keys and descriptions (all pages)" />
                        <CheckBox Grid.Column="1" Content="Only changed from default" IsChecked="{Binding OnlyNonDefault}" Margin="12,0,0,0" />
                    </Grid>

                    <ListBox Grid.Row="2" Style="{StaticResource OptionPages}" />
                    <ListBox Grid.Row="2" Grid.Column="1" Style="{StaticResource OptionList}" />

                    <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveCommand}" MinWidth="130"
                                IsEnabled="{Binding HasChanges}" />
                        <Button DockPanel.Dock="Right" Content="Discard" Command="{Binding DiscardCommand}" Margin="0,0,8,0"
                                IsEnabled="{Binding HasChanges}" />
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{Binding Source}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Logs" DataContext="{Binding Logs}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- source -->
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="Find on server" Command="{Binding FindOnServerCommand}"
                                ToolTip="Read Zomboid/Logs over SFTP" />
                        <Button DockPanel.Dock="Left" Content="Open folder…" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0"
                                ToolTip="A local Logs folder (a server on this PC)" />
                        <TextBlock Text="{Binding Source}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.6"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <!-- log type and filters -->
                    <Grid Grid.Row="1" Margin="0,0,0,8" IsEnabled="{Binding IsOpen}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" MinWidth="150" ToolTip="Which log" />
                        <TextBox Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"
                                 ToolTip="Filter by text or player" />
                        <CheckBox Grid.Column="2" Content="Server lines" IsChecked="{Binding ShowServerLines}" Margin="12,0,0,0"
                                  Visibility="{Binding IsChat, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Also show the chat server's own lines (start-up, players joining chats)" />
                        <CheckBox Grid.Column="3" Content="Follow" IsChecked="{Binding Follow}" Margin="12,0,0,0"
                                  ToolTip="Read new lines every 5 seconds" />
                        <Button Grid.Column="4" Content="&#xE72C;" FontFamily="{StaticResource IconFont}" Command="{Binding RefreshCommand}"
                                Margin="8,0,0,0" ToolTip="Read new lines now" />
                        <Button Grid.Column="5" Content="&#xE74D;" FontFamily="{StaticResource IconFont}" Command="{Binding ClearCommand}"
                                Margin="6,0,0,0" ToolTip="Clear the list (the log file is not touched)" />
                    </Grid>

                    <ListBox Grid.Row="2" x:Name="LogList" ItemsSource="{Binding View}" controls:PlayerMenu.Enabled="True" FontSize="13" IsSynchronizedWithCurrentItem="False"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="6,2" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LogLineItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" Opacity="0.45" Margin="0,0,10,0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                               VerticalAlignment="Top" Padding="0,1,0,0" />
                                    <TextBlock x:Name="Body" Grid.Column="1" TextWrapping="Wrap">
                                        <Run x:Name="Channel" Text="{Binding ChannelText, Mode=OneWay}" Foreground="#8A9BB0" />
                                        <Run x:Name="Author" Text="{Binding AuthorText, Mode=OneWay}" FontWeight="SemiBold" Foreground="#7FB8FF" />
                                        <Run Text="{Binding Text, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Server">
                                        <Setter TargetName="Body" Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Alert">
                                        <Setter TargetName="Body" Property="Foreground" Value="#F2C14E" />
                                        <Setter TargetName="Author" Property="Foreground" Value="#F2C14E" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Marker">
                                        <Setter TargetName="Body" Property="Foreground" Value="#8FD694" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="3" Text="{Binding StatusText}" Opacity="0.7" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />

                    <!-- quick broadcast -->
                    <Grid Grid.Row="4" Margin="0,8,0,0" IsEnabled="{Binding DataContext.IsSessionActive, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LogMessageBox" Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" KeyDown="LogMessage_KeyDown"
                                 ToolTip="Broadcast to all players (servermsg). Enter sends." />
                        <Button Grid.Column="1" Content="Broadcast" Command="{Binding SendMessageCommand}" Margin="8,0,0,0" MinWidth="100" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Bridge" DataContext="{Binding Bridge}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- setup and connection -->
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="Prepare Workshop upload" Command="{Binding PrepareUploadCommand}"
                                ToolTip="Copy the bridge mod to %USERPROFILE%\Zomboid\Workshop, ready to upload from the game's Workshop menu" />
                        <Button DockPanel.Dock="Left" Content="Copy server settings" Command="{Binding CopyServerSettingsCommand}" Margin="8,0,0,0"
                                ToolTip="The Mods= and WorkshopItems= values to add to the server" />
                        <Border DockPanel.Dock="Left" Style="{StaticResource ToolSeparatorLine}" />
                        <Button DockPanel.Dock="Left" Content="Find on server" Command="{Binding FindOnServerCommand}"
                                ToolTip="Talk to the bridge through Zomboid/Lua over SFTP" />
                        <Button DockPanel.Dock="Left" Content="Open folder…" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0"
                                ToolTip="A local Zomboid/Lua folder (a server on this PC)" />
                        <Button DockPanel.Dock="Left" Content="&#xE72C;" FontFamily="{StaticResource IconFont}" Command="{Binding RefreshCommand}"
                                Margin="8,0,0,0" IsEnabled="{Binding IsConnected}" ToolTip="Refresh now" />
                        <CheckBox DockPanel.Dock="Left" Content="Every 15 s" IsChecked="{Binding AutoRefresh}" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding Source}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <!-- how to install, until the bridge answers -->
                    <Border Grid.Row="1" Style="{StaticResource Card}"
                            Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Setting up the bridge" Style="{StaticResource SectionTitle}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20">
                                <Run Text="1. The mod is on the Workshop (unlisted, id below). To publish an update: Prepare Workshop upload, then Workshop in the game's main menu." /><LineBreak />
                                <Run Text="2. Add it to the server: Mods = SpiffoCONBridge, WorkshopItems = its Workshop id (Copy server settings), then restart the server." /><LineBreak />
                                <Run Text="3. Enable SFTP on the left and press Find on server." /><LineBreak />
                                <Run Text="The bridge answers while the server is running a game: with PauseEmpty on, an empty server is paused and the bridge waits for a player." Foreground="#F2C14E" />
                            </TextBlock>
                            <TextBlock Margin="0,8,0,0" Opacity="0.7">
                                <Run Text="Workshop id:" />
                                <Run Text="{Binding WorkshopId, Mode=OneWay, TargetNullValue='not uploaded yet'}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Text="{Binding WorldText}" Margin="0,0,0,8" Opacity="0.85"
                               Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />

                    <!-- players and inventory -->
                    <Grid Grid.Row="2" IsEnabled="{Binding IsConnected}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="420" />
                        </Grid.ColumnDefinitions>
                        <ListView ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}" ItemContainerStyle="{StaticResource GridRow}" controls:PlayerMenu.Enabled="True">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Player" Width="125" DisplayMemberBinding="{Binding Username}" />
                                    <GridViewColumn Header="Role" Width="70" DisplayMemberBinding="{Binding Role}" />
                                    <GridViewColumn Header="Position" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12">
                                                    <Run Text="{Binding X, Mode=OneWay}" />,<Run Text="{Binding Y, Mode=OneWay}" />,<Run Text="{Binding Z, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Health" Width="60" DisplayMemberBinding="{Binding Health}" />
                                    <GridViewColumn Width="72" DisplayMemberBinding="{Binding ZombiesNear}">
                                        <GridViewColumnHeader Content="Zombies" ToolTip="Zombies within about 30 squares of the player (bridge v7)" />
                                    </GridViewColumn>
                                <GridViewColumn Header="Vehicle" Width="120" DisplayMemberBinding="{Binding Vehicle}" />
                                <GridViewColumn Header="Hours" Width="55" DisplayMemberBinding="{Binding HoursSurvived}" />
                                <GridViewColumn Header="Kills" Width="50" DisplayMemberBinding="{Binding ZombieKills}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <DockPanel Grid.Column="1" Margin="10,0,0,0">
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding HasPlayer, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="Heal" Command="{Binding HealCommand}" CommandParameter="{Binding SelectedPlayer}"
                                        ToolTip="Full heal: wounds, fractures, bites (bridge v2)" Margin="0,0,6,0" />
                                <Button Content="Copy x,y,z" Command="{Binding CopyPositionCommand}" CommandParameter="{Binding SelectedPlayer}" Margin="0,0,6,0" />
                                <Button Content="To Players tab" Command="{Binding UseInPlayersTabCommand}" CommandParameter="{Binding SelectedPlayer}"
                                        ToolTip="Put this player and their position in the Players tab (teleport others here)" />
                            </WrapPanel>
                            <!-- profession, traits, condition and skills: bridge v7 -->
                            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,8"
                                    Visibility="{Binding PlayerSheet, Converter={StaticResource NullToCollapsed}}">
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding PlayerSheet}" TextWrapping="Wrap" FontSize="12" />
                                </ScrollViewer>
                            </Border>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding InventoryTitle}" TextWrapping="Wrap" Margin="0,0,0,6" FontWeight="SemiBold" />
                            <ListView ItemsSource="{Binding Inventory}" ItemContainerStyle="{StaticResource GridRow}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Item" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock ToolTip="{Binding FullType}">
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                        <Run x:Name="Eq" Text="" Foreground="#8FD694" />
                                                    </TextBlock>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Equipped}" Value="True">
                                                            <Setter TargetName="Eq" Property="Text" Value="(equipped)" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="#" Width="36" DisplayMemberBinding="{Binding Count}" />
                                        <GridViewColumn Header="In" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ContainerShort}" ToolTip="{Binding Container}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="−1" FontSize="11" Padding="6,1" MinHeight="0" MinWidth="0" ToolTip="Remove one"
                                                                Command="{Binding DataContext.RemoveOneCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="All" FontSize="11" Padding="6,1" MinHeight="0" MinWidth="0" Margin="4,0,0,0" ToolTip="Remove all of them"
                                                                Command="{Binding DataContext.RemoveAllCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Grid>

                    <Expander Grid.Row="3" Header="Vehicles in loaded areas" Margin="0,8,0,0" IsEnabled="{Binding IsConnected}">
                        <ListView ItemsSource="{Binding Vehicles}" MaxHeight="160" ItemContainerStyle="{StaticResource GridRow}" Margin="0,6,0,0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Vehicle" Width="220" DisplayMemberBinding="{Binding Script}" />
                                    <GridViewColumn Header="Id" Width="70" DisplayMemberBinding="{Binding Id}" />
                                    <GridViewColumn Header="Position" Width="140">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12">
                                                    <Run Text="{Binding X, Mode=OneWay}" />,<Run Text="{Binding Y, Mode=OneWay}" />,<Run Text="{Binding Z, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Driver" Width="140" DisplayMemberBinding="{Binding Driver}" />
                                    <GridViewColumn Header="Engine on" Width="80" DisplayMemberBinding="{Binding EngineRunning}" />
                                    <GridViewColumn Width="270">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Key" FontSize="11" Padding="8,1" MinHeight="0" Margin="0,0,4,0"
                                                            ToolTip="Give a key of this vehicle to the player selected in the list above (bridge v7)"
                                                            Command="{Binding DataContext.GiveVehicleKeyCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Repair" FontSize="11" Padding="8,1" MinHeight="0"
                                                            Command="{Binding DataContext.RepairVehicleCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Refuel" FontSize="11" Padding="8,1" MinHeight="0" Margin="4,0,0,0"
                                                            Command="{Binding DataContext.RefuelVehicleCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Remove" FontSize="11" Padding="8,1" MinHeight="0" Margin="4,0,0,0"
                                                            Command="{Binding DataContext.RemoveVehicleCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Expander>

                    <TextBlock Grid.Row="4" Text="{Binding StatusText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="Map" x:Name="MapTab" DataContext="{Binding Map}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- toolbar -->
                    <WrapPanel Grid.ColumnSpan="3" Margin="0,0,0,8">
                        <Button Content="&#xE9A6;" FontFamily="{StaticResource IconFont}" Command="{Binding FitCommand}" ToolTip="Show the whole map"
                                IsEnabled="{Binding HasMap}" VerticalAlignment="Center" />
                        <Button Content="&#xE72C;" FontFamily="{StaticResource IconFont}" Command="{Binding ReloadCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTip="Read the server's Map= again and copy its mod maps again (after a map mod update)" />
                        <CheckBox Content="Satellite" IsChecked="{Binding Satellite}" Margin="12,0,0,0" MinWidth="0" VerticalAlignment="Center"
                                  ToolTip="The game's top-down image of the world instead of the map" />
                        <CheckBox Content="Vehicles" IsChecked="{Binding ShowVehicles}" Margin="12,0,0,0" MinWidth="0" VerticalAlignment="Center"
                                  ToolTip="Vehicles in the loaded areas (blue; green when someone drives)" />
                        <CheckBox Content="Zombies" IsChecked="{Binding ShowZombies}" Margin="12,0,0,0" MinWidth="0" VerticalAlignment="Center"
                                  ToolTip="Where the zombies of the loaded areas are, red, deeper where there are more (bridge v8)" />
                        <CheckBox Content="Deaths" IsChecked="{Binding ShowDeaths}" Margin="12,0,0,0" MinWidth="0" VerticalAlignment="Center"
                                  ToolTip="Where players died, a red cross each: the last 100 the bridge keeps (bridge v8)" />
                        <CheckBox Content="Safehouses" IsChecked="{Binding ShowSafehouses}" Margin="12,0,0,0" MinWidth="0" VerticalAlignment="Center"
                                  ToolTip="The players' safehouses as green areas, with the owner's name (bridge v7)" />
                        <CheckBox Content="Follow" IsChecked="{Binding Follow}" Margin="12,0,0,0" MinWidth="0" VerticalAlignment="Center"
                                  ToolTip="Keep the selected player in the middle of the map as they move" />
                        <Border Style="{StaticResource ToolSeparatorLine}" Height="24" />
                        <TextBlock Text="Horde" VerticalAlignment="Center" ToolTip="For the right-click menu: how many zombies to spawn, and the radius of the spawn and of the clean-ups" />
                        <TextBox Text="{Binding HordeCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberField}" Margin="8,0,0,0"
                                 ToolTip="How many zombies Spawn zombies here creates (1-500)" />
                        <TextBlock Text="radius" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBox Text="{Binding HordeRadius, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberField}" Margin="8,0,0,0"
                                 ToolTip="Squares around the clicked spot where zombies are placed or removed (1-50), or their corpses removed (1-100)" />
                        <Border Style="{StaticResource ToolSeparatorLine}" Height="24" />
                        <Button Content="Download from server" Command="{Binding DownloadCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                                Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Copy the game's map files from the server over SFTP (about 17 MB, once for all servers)" />
                        <Button Content="Download satellite view" Command="{Binding DownloadSatelliteCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                                Visibility="{Binding CanDownloadSatellite, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Copy the game's pyramid.zip from the server over SFTP (about 50 MB, once)" />
                        <Button Content="&#xE8B7;" FontFamily="{StaticResource IconFont}" Command="{Binding ChooseFolderCommand}" VerticalAlignment="Center"
                                ToolTip="Game folder: read the map from a Project Zomboid (or dedicated server) install on this PC" />
                        <ProgressBar Width="80" Height="4" Margin="12,0,0,0" IsIndeterminate="True" VerticalAlignment="Center"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>

                    <!-- the map -->
                    <Border Grid.Row="1" CornerRadius="6" ClipToBounds="True" Background="#18808080">
                        <Grid>
                            <controls:WorldMapView x:Name="MapView" ContextMenuOpening="MapView_ContextMenuOpening" Scene="{Binding Scene}" Players="{Binding Bridge.Players}" Vehicles="{Binding Bridge.Vehicles}" Safehouses="{Binding Bridge.Safehouses}" ShowSafehouses="{Binding ShowSafehouses}"
                                                   Deaths="{Binding Bridge.Deaths}" ShowDeaths="{Binding ShowDeaths}" ZombieCells="{Binding Bridge.ZombieCells}" ShowZombies="{Binding ShowZombies}"
                                                   ShowVehicles="{Binding ShowVehicles}" Satellite="{Binding Satellite}" SelectedPlayer="{Binding SelectedPlayer}"
                                                   PointerText="{Binding PointerText}" ContextSquare="{Binding ContextSquare}">
                                <controls:WorldMapView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding TeleportHereText}" Command="{Binding TeleportHereCommand}" />
                                        <MenuItem Header="Copy these coordinates" Command="{Binding CopySquareCommand}" />
                                        <Separator />
                                        <MenuItem Header="{Binding SpawnHordeText}" Command="{Binding SpawnHordeCommand}" />
                                        <MenuItem Header="{Binding RemoveZombiesText}" Command="{Binding RemoveZombiesCommand}" />
                                        <Separator />
                                        <MenuItem Header="{Binding RemoveCorpsesText}" Command="{Binding RemoveCorpsesCommand}"
                                                  ToolTip="Zombie corpses on every floor, through the bridge (v6); the corpses of players and animals stay" />
                                        <MenuItem Header="{Binding RemoveGroundItemsText}" Command="{Binding RemoveGroundItemsCommand}"
                                                  ToolTip="Items lying on the floor, on every floor (bridge v7): counted first, then asked. What is in containers, on tables and shelves, or inside a safehouse is not touched" />
                                        <MenuItem Header="{Binding StopFiresText}" Command="{Binding StopFiresCommand}"
                                                  ToolTip="Every fire in the area, on every floor (bridge v7); lit campfires are left" />
                                        <MenuItem Header="{Binding RemoveWrecksText}" Command="{Binding RemoveWrecksCommand}"
                                                  ToolTip="Burnt and smashed vehicles (bridge v8): counted first, then asked. Cars that can still be driven stay" />
                                        <Separator />
                                        <MenuItem Header="{Binding SpawnItemText}" Command="{Binding SpawnItemCommand}" IsEnabled="{Binding HasSpawnItem}"
                                                  ToolTipService.ShowOnDisabled="True"
                                                  ToolTip="The item and quantity chosen in the Catalog tab, on the ground of this square (bridge v8; only near a player)" />
                                        <MenuItem Header="Put a kit here" ItemsSource="{Binding Kits}" IsEnabled="{Binding HasKits}" ToolTipService.ShowOnDisabled="True"
                                                  ToolTip="Every item of a kit of the Kits tab, on the ground of this square (bridge v8; only near a player)">
                                            <MenuItem.ItemContainerStyle>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header" Value="{Binding Name}" />
                                                    <Setter Property="Command" Value="{Binding DataContext.SpawnKitCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{Binding RemoveSafehouseText}" Command="{Binding RemoveSafehouseCommand}" IsEnabled="{Binding HasContextSafehouse}" ToolTipService.ShowOnDisabled="True"
                                                  ToolTip="Right-click inside a safehouse (the green areas, bridge v7). What is in it stays, but it is no longer protected" />
                                    </ContextMenu>
                                </controls:WorldMapView.ContextMenu>
                            </controls:WorldMapView>
                            <!-- no map yet -->
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" Opacity="0.8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasMap, Converter={StaticResource InverseBoolToVisibility}}" />
                            <!-- positions need the bridge -->
                            <Border Background="#E0202020" CornerRadius="6" Padding="12,8" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Visibility="{Binding BridgeHint, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Player positions come from the SpiffoCON Bridge." VerticalAlignment="Center" />
                                    <Button Content="Connect the bridge" Command="{Binding Bridge.FindOnServerCommand}" Margin="10,0,0,0"
                                            ToolTip="The same as Find on server in the Bridge tab" />
                                </StackPanel>
                            </Border>
                            <!-- legend -->
                            <Expander Header="Legend" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#E0202020"
                                      Visibility="{Binding HasMap, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Margin="4,2,4,4">
                                    <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#D29E69" BorderBrush="#60808080" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Houses" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#B8CD54" BorderBrush="#60808080" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Shops and offices" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#F5E13C" BorderBrush="#60808080" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Restaurants, bars, fun" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#8B75EB" BorderBrush="#60808080" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Police, fire, schools, churches" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#E58097" BorderBrush="#60808080" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Medical" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#7FCEE1" BorderBrush="#60808080" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Hotels" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="#383635" BorderBrush="#60808080" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Industrial" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                                    <TextBlock Text="Wheel: zoom · drag: move · click a player to select · right-click: player actions, or teleport, zombies and coordinates here"
                                               Opacity="0.6" FontSize="11.5" TextWrapping="Wrap" MaxWidth="220" Margin="0,8,0,0" />
                                </StackPanel>
                            </Expander>

                        </Grid>
                    </Border>

                    <!-- status -->
                    <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding PointerText}" FontFamily="{StaticResource MonoFont}" FontSize="12" MinWidth="120" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PlayersText}" Opacity="0.7" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding StatusText}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0"
                                   ToolTip="{Binding StatusText}" Visibility="{Binding HasMap, Converter={StaticResource BoolToVisibility}}" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Broadcast">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Color from the cursor on:" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8" />
                        <ItemsControl ItemsSource="{Binding ColorPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ColorPreset}">
                                    <Button Width="28" Height="28" Margin="2,0" Padding="0" MinWidth="0" MinHeight="0"
                                            ToolTip="{Binding Name}" Tag="{Binding}" Click="ColorPreset_Click">
                                        <Border Width="16" Height="16" CornerRadius="3" Background="{Binding Hex}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBox Grid.Row="1" x:Name="MessageEditor" Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Top" />

                    <TextBlock Grid.Row="2" Text="Preview" Style="{StaticResource FieldLabel}" />
                    <Border Grid.Row="3" Background="#E0101010" CornerRadius="4" Padding="10,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding MessagePreview}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock controls:RichText.Segments="{Binding}" TextWrapping="Wrap" FontSize="14" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding MessageResult}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding MessageInfo}" VerticalAlignment="Center" Opacity="0.6" Margin="12,0" />
                        <Button Grid.Column="2" Content="Send to all players" Command="{Binding SendMessageCommand}"
                                IsEnabled="{Binding IsSessionActive}" MinWidth="140" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Maintenance" DataContext="{Binding Maintenance}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="370" />
                    </Grid.ColumnDefinitions>

                    <!-- mod updates -->
                    <Border Style="{StaticResource Card}" VerticalAlignment="Stretch" Margin="0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Check now" Command="{Binding CheckUpdatesCommand}"
                                            IsEnabled="{Binding DataContext.IsSessionActive, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <ProgressBar DockPanel.Dock="Right" Width="60" Height="4" Margin="0,0,10,0" IsIndeterminate="True"
                                                 Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="Mod updates" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding UpdatesText}" TextWrapping="Wrap" Margin="0,8,0,8" />
                            </StackPanel>
                            <ListView ItemsSource="{Binding Mods}" ItemContainerStyle="{StaticResource GridRow}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="46">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="&#xE8A7;" FontFamily="{StaticResource IconFont}" Padding="6,2" MinHeight="0"
                                                            ToolTip="Open the Workshop page in the browser"
                                                            Command="{Binding DataContext.OpenWorkshopPageCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Workshop item" Width="170">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkshopId}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="State" Width="128">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock x:Name="State" Text="{Binding StateText}" />
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                            <Setter TargetName="State" Property="Foreground" Value="#F2C14E" />
                                                            <Setter TargetName="State" Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Server's copy" Width="112" DisplayMemberBinding="{Binding OnServer}" />
                                        <GridViewColumn Header="On Steam" Width="112" DisplayMemberBinding="{Binding OnSteam}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- restart -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                                    IsEnabled="{Binding DataContext.IsSessionActive, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel>
                                    <TextBlock Text="Restart with a countdown" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding IsIdle}">
                                        <TextBlock Text="In" VerticalAlignment="Center" />
                                        <ComboBox ItemsSource="{Binding MinuteChoices}" SelectedItem="{Binding RestartMinutes}" Margin="8,0" MinWidth="70" />
                                        <TextBlock Text="minutes" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Warning (in chat, as time runs out)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding RestartMessage, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" IsEnabled="{Binding IsIdle}"
                                             ToolTip="{}{time} becomes &quot;5 minutes&quot;, &quot;30 seconds&quot;...; &lt;RGB:r,g,b&gt; sets the color" />
                                    <TextBlock Text="{}{time} becomes the time left. At zero: save, then quit; starting the server again is up to the host."
                                               Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="Start countdown" Command="{Binding StartRestartCommand}" Style="{StaticResource PairButton}"
                                                Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Call it off" Command="{Binding CancelRestartCommand}" Style="{StaticResource PairButton}"
                                                Visibility="{Binding IsCountingDown, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Restart now" Command="{Binding RestartNowCommand}" Style="{StaticResource PairButton}"
                                                Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="No countdown: one line in chat for the players online, then save and quit (asks first)" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding CountdownText}" FontSize="28" FontWeight="SemiBold" Foreground="#F2C14E" Margin="0,8,0,0"
                                               Visibility="{Binding IsCountingDown, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding RestartStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- notifications -->
                            <Border Style="{StaticResource Card}" Margin="0"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel>
                                    <TextBlock Text="Desktop notifications" Style="{StaticResource SectionTitle}" />
                                    <CheckBox Content="Players joining and leaving" IsChecked="{Binding NotifyPlayerJoins}" Margin="0,8,0,0"
                                              ToolTip="Seen with the online list: the Players tab refreshes it every 30 s while its auto refresh is on" />
                                    <CheckBox Content="Chat messages containing" IsChecked="{Binding NotifyChat}" Margin="0,6,0,0"
                                              ToolTip="Needs the Logs tab following the server's chat log" />
                                    <TextBox Text="{Binding NotifyChatWords, UpdateSourceTrigger=PropertyChanged}" Margin="28,4,0,0" IsEnabled="{Binding NotifyChat}"
                                             ToolTip="Words separated by commas; empty: every message" />
                                    <TextBlock Text="Words separated by commas, empty for every message. Chat comes from the Logs tab, while it follows the chat log."
                                               Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="28,4,0,0" />
                                    <CheckBox Content="Connection lost and server back" IsChecked="{Binding NotifyConnection}" Margin="0,6,0,0" />
                                    <CheckBox Content="A player dies" IsChecked="{Binding NotifyDeaths}" Margin="0,6,0,0"
                                              ToolTip="Where and, when the game says, by whom (bridge v8)" />
                                    <CheckBox Content="Only while SpiffoCON is in the background" IsChecked="{Binding NotifyOnlyWhenInactive}" Margin="0,6,0,0" />
                                    <Button Content="Try one" Command="{Binding TestNotificationCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- SpiffoCON's own updates -->
                            <Border Style="{StaticResource Card}" Margin="0,10,0,0"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel>
                                    <TextBlock Text="SpiffoCON updates" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding AppVersionText}" Margin="0,8,0,0" />
                                    <CheckBox Content="Look for a new version once a day" IsChecked="{Binding CheckForUpdates}" Margin="0,6,0,0"
                                              ToolTip="Asks GitHub for the latest release (only SpiffoCON's version is sent). A new version is offered with its notes; installing it takes one click and SpiffoCON opens again." />
                                    <Button Content="Check now" Command="{Binding CheckForUpdatesNowCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Opacity="0.8" Margin="0,8,0,0"
                                               Visibility="{Binding UpdateStatus, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Files" x:Name="FilesTab">
                <TextBox Margin="0,8,0,0" Text="{Binding SftpReport, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="{StaticResource MonoFont}" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
            </TabItem>
        </TabControl>

        <!-- online players, always in view; the same right-click menu as everywhere -->
        <DockPanel Grid.Column="3" Width="180" Margin="10,12,12,8" DataContext="{Binding Players}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="&#xE72C;" FontFamily="{StaticResource IconFont}" Padding="6,4" MinWidth="0"
                        Command="{Binding RefreshCommand}" ToolTip="Refresh now (it also refreshes by itself every 30 s)" />
                <TextBlock Text="{Binding OnlineCount}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="Right-click a player for the actions; double-click opens the Players tab. With the Map tab open, a click shows and follows the player."
                       Opacity="0.6" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" />
            <ListBox x:Name="OnlineSidebar" ItemsSource="{Binding DataContext.SidebarPlayers, RelativeSource={RelativeSource AncestorType=Window}}"
                     controls:PlayerMenu.Enabled="True" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnlineSidebar_MouseDoubleClick" PreviewMouseLeftButtonUp="OnlineSidebar_Click">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SidebarPlayer}">
                        <StackPanel ToolTip="{Binding Username}">
                            <TextBlock Text="{Binding Username}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" FontSize="11.5" Opacity="0.6" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="4" Padding="16,6" Background="#20808080">
            <DockPanel>
                <!-- SpiffoCON's own updates, from any tab -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="{Binding AppVersionShort, StringFormat='{}{0} · '}" Opacity="0.6" />
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvailableVersion}" Value="{x:Null}">
                                        <Setter Property="FontWeight" Value="Normal" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Hyperlink Command="{Binding CheckForUpdatesNowCommand}"
                                   ToolTip="Asks GitHub for the latest release (only SpiffoCON's version is sent)">
                            <Run Text="{Binding UpdateLinkText, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
