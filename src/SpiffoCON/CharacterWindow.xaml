<Window x:Class="SpiffoCON.CharacterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1320" Height="800" MinWidth="960" MinHeight="520"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="16,12,16,10">
        <!-- who -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" VerticalAlignment="Top" ToolTip="Read again now (it follows the bridge's refreshes by itself)"
                    FontFamily="{StaticResource IconFont}" Content="&#xE72C;" Padding="10,7" />
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Opacity="0.8" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>
        <Border DockPanel.Dock="Top" Background="#30F2C14E" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
        </Border>
        <!-- what the last action said, and when this was read -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding UpdatedText}" Opacity="0.6" Margin="12,0,0,0" />
            <TextBlock Text="{Binding Main.StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Main.StatusText}" Opacity="0.85" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- every action on the player, on the right: the same as the right-click menu, always in sight -->
            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="8,10,8,8" Margin="10,0,0,0" Width="186">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Actions" Style="{StaticResource CardTitle}" Margin="4,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ActionsPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- where and how they are -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Visibility="{Binding Facts.Count, Converter={StaticResource PositiveToVisible}}">
                        <ItemsControl ItemsSource="{Binding Facts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="104" Opacity="0.65" />
                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasSheet, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Health" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding Alarm}" Foreground="#FF6B6B" FontWeight="SemiBold" Margin="0,0,0,8"
                                       Visibility="{Binding Alarm, Converter={StaticResource NullToCollapsed}}" />
                            <DockPanel Visibility="{Binding HasHealth, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding HealthText}" Margin="10,0,0,0" MinWidth="64" TextAlignment="Right" />
                                <ProgressBar Value="{Binding Health, Mode=OneWay}" Maximum="100" Height="8" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Parts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Width="104" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Health}" Opacity="0.7" MinWidth="30" TextAlignment="Right" ToolTip="Health of this part, 0 to 100" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#F2C14E" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding PartsNote}" Style="{StaticResource Note}" Margin="0,0,0,6"
                                       Visibility="{Binding PartsNote, Converter={StaticResource NullToCollapsed}}" />
                            <ItemsControl ItemsSource="{Binding Stats}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,5">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Width="104" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Opacity="0.7" MinWidth="44" TextAlignment="Right" />
                                            <ProgressBar Value="{Binding Value, Mode=OneWay}" Maximum="1" Height="5" VerticalAlignment="Center" Foreground="#F2C14E" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding StatsNote}" Style="{StaticResource Note}"
                                       Visibility="{Binding StatsNote, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- traits and skills -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Visibility="{Binding Traits, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel>
                            <TextBlock Text="Traits" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding Traits}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Visibility="{Binding Skills.Count, Converter={StaticResource PositiveToVisible}}">
                        <StackPanel>
                            <TextBlock Text="Skills" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding Skills}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Opacity="0.65" Margin="0,0,0,3" />
                                            <ItemsControl ItemsSource="{Binding Skills}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,2">
                                                            <!-- adds experience: a menu of amounts (RCON addxp) -->
                                                            <Button DockPanel.Dock="Right" Content="+" Padding="7,0" MinWidth="0" MinHeight="0" Height="22" Margin="6,0,0,0"
                                                                    FontWeight="SemiBold" IsEnabled="{Binding CanAdd}" ToolTip="{Binding AddTip}"
                                                                    ToolTipService.ShowOnDisabled="True" Click="SkillPlus_Click" />
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Width="104" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Level}" Width="20" TextAlignment="Right" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" ToolTip="Level, 0 to 10" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding XpText}" Opacity="0.7" FontSize="11" MinWidth="92" TextAlignment="Right"
                                                                       VerticalAlignment="Center" ToolTip="Experience gained in this level, of what the next level takes" />
                                                            <ProgressBar Value="{Binding Level, Mode=OneWay}" Maximum="10" Height="5" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- equipment and inventory -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" MaxHeight="280"
                        Visibility="{Binding HasEquipment, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Equipment" Style="{StaticResource CardTitle}" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding EquipmentNote}" Style="{StaticResource Note}"
                                   Visibility="{Binding EquipmentNote, Converter={StaticResource NullToCollapsed}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Equipment}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,5" ToolTip="{Binding Group}" Background="Transparent" MouseRightButtonUp="Equipment_MouseRightButtonUp">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Slot}" Width="118" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ConditionText}" Opacity="0.7" MinWidth="40" TextAlignment="Right"
                                                       ToolTip="Condition: 100% is new" />
                                            <Image DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"
                                                   Source="{Binding IconPath, Converter={StaticResource Icon}}" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding InventoryTitle}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" />
                        <!-- right-click an item for what can be done to it: repair, clean, fill, recharge, one more, remove -->
                        <ListView x:Name="InventoryList" ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource GridRow}" MinHeight="80"
                                  PreviewMouseRightButtonUp="Inventory_MouseRightButtonUp">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Item" Width="138">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel ToolTip="{Binding FullType}">
                                                    <!-- the Catalog's icon: empty for an item it does not know (a mod not loaded there) -->
                                                    <Image DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"
                                                           Source="{Binding IconPath, Converter={StaticResource Icon}}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                        <Run x:Name="Eq" Text="" Foreground="#8FD694" />
                                                    </TextBlock>
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Equipped}" Value="True">
                                                        <Setter TargetName="Eq" Property="Text" Value=" (in use)" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="#" Width="34" DisplayMemberBinding="{Binding Count}" />
                                    <GridViewColumn Header="In" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ContainerShort}" ToolTip="{Binding Container}" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="State" Width="72">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="State" Text="{Binding StateText}" ToolTip="{Binding StateTip}" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsPoor}" Value="True">
                                                        <Setter TargetName="State" Property="Foreground" Value="#FF6B6B" />
                                                        <Setter TargetName="State" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="94">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="−1" Padding="8,2" MinWidth="0" ToolTip="Remove one (asked first)"
                                                            Command="{Binding DataContext.RemoveOneCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                                                    <Button Content="All" Padding="8,2" MinWidth="0" Margin="4,0,0,0" ToolTip="Remove all of them (asked first)"
                                                            Command="{Binding DataContext.RemoveAllCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
